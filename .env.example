# Server-only. Never put keys in the browser or commit .env.
OPENROUTER_API_KEY=
DECISION_PROVIDER=decider
DECISION_MODEL=perplexity/pplx-decider-v1.3:free
# Server-only menu question profile. Default is the evaluated lean-v9 guarded single-item profile; lean-v8 is an explicit rollback.
# Allowed: lean-v8, lean-v9.
MENU_QUESTION_PROFILE=lean-v9
# PORT=4173

# Guarded first-clause overlap; set sequential to roll back scheduling.
DECISION_SCHEDULING=guarded-overlap
