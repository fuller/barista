# Server-only. Never put keys in the browser or commit .env.
OPENROUTER_API_KEY=
DECISION_PROVIDER=decider
DECISION_MODEL=perplexity/pplx-decider-v1.3:free
# Server-only menu question profile. Default is the evaluated lean-v10 compact cart profile; lean-v9 and lean-v8 are explicit rollbacks.
# Allowed: lean-v8, lean-v9, lean-v10.
MENU_QUESTION_PROFILE=lean-v10
# PORT=4173

# Guarded first-clause overlap; set sequential to roll back scheduling.
DECISION_SCHEDULING=guarded-overlap

# Optional real pricing: run npm run pricing:browser on a Chrome/display host.
# App server and browser service share a random secret of at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
STARBUCKS_BROWSER_URL=http://127.0.0.1:4174
BARISTA_BROWSER_TOKEN=
# Browser service only: BARISTA_BROWSER_HOST=127.0.0.1, BARISTA_BROWSER_PORT=4174
