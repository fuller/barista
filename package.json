{
  "name": "barista-order-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "e2e:serve": "node tests/e2e-server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "E2E_TELEMETRY_DISABLED=1 e2e run --no-cache",
    "check": "tsc --noEmit",
    "eval": "node scripts/evaluate-menu.mjs",
    "eval:menu": "node scripts/evaluate-menu.mjs",
    "start": "node scripts/start.mjs",
    "benchmark:menu": "node scripts/benchmark-menu-latency.mjs",
    "pricing:probe": "node scripts/probe-starbucks-pricing.mjs",
    "release:check": "node scripts/release.mjs --check",
    "release:archive": "node scripts/release.mjs",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.16.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "e2e": "0.23.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "wrangler": "4.162.0"
  },
  "description": "Coffee ordering simulator with a portable Worker and React interface",
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  },
  "license": "MIT"
}
